# =============================================================================
# SAFES - Environment Variables
# Copy this to .env and fill in your values
# =============================================================================

# LLM Provider: openai, anthropic, gemini, ollama (auto-detects if not set)
LLM_PROVIDER=openai

# OpenAI (also works for any OpenAI-compatible API)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # Override for compatible APIs (Groq, Together, etc.)

# Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (local LLM - no API key needed, just run Ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# Override model name (auto-set per provider if not specified)
# LLM_MODEL=gpt-4

# General settings
ENVIRONMENT=development
LOG_LEVEL=DEBUG
SECRET_KEY=replace_with_random_secret
